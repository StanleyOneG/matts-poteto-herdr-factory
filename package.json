{
  "name": "pi-legion",
  "version": "0.1.0",
  "type": "module",
  "description": "Explicit, durable intake for local Pi Legati",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-ai": "*"
  },
  "dependencies": {
    "zod": "^4.3.6",
    "pi-subagents": "0.76.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@types/node": "^22.19.0",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "typebox": "1.3.27",
    "@earendil-works/pi-ai": "1.0.4"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "verify:pi": "node --import tsx scripts/verify-pi.mjs"
  }
}
